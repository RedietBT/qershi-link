# ==============================================================================
# Qershi Link - Central Environment Variables Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# DO NOT commit real secrets (.env) to version control.

# Database Credentials
POSTGRES_DB=qershi-link
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/qershi-link?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis Cache & Token Store
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security & Authentication
# Must be a 256-bit (64 hex characters) secret key shared across all microservices
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# AfroMessage SMS Gateway Credentials
AFROMESSAGE_API_KEY=your_afromessage_api_token_here
AFROMESSAGE_API_URL=https://api.afromessage.com/api/send

# Microservice HTTP Ports
IDENTITY_SERVICE_PORT=8080
PROFILE_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
LOAN_ORIGINATION_SERVICE_PORT=8084
LOAN_MANAGEMENT_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
SWAGGER_HUB_PORT=8090

# Microservice gRPC Ports
IDENTITY_GRPC_PORT=9080
PROFILE_GRPC_PORT=9081
ACCOUNT_GRPC_PORT=9082
TRANSACTION_GRPC_PORT=9083
LOAN_ORIGINATION_GRPC_PORT=9084
LOAN_MANAGEMENT_GRPC_PORT=9085
NOTIFICATION_GRPC_PORT=9086

# gRPC Inter-Service Communication Addresses (Local Default)
GRPC_CLIENT_NOTIFICATION_SERVICE_ADDRESS=static://localhost:9086
GRPC_CLIENT_PROFILE_SERVICE_ADDRESS=static://localhost:9081
GRPC_CLIENT_ACCOUNT_SERVICE_ADDRESS=static://localhost:9082
