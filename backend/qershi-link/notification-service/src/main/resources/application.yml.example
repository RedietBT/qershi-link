# Notification Service Configuration Template
# Copy this file to application.yml and replace placeholder values for local development.

server:
  port: ${SERVER_PORT:8086}

spring:
  application:
    name: notification-service
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/qershi-link?stringtype=unspecified}
    username: ${SPRING_DATASOURCE_USERNAME:postgres}
    password: ${SPRING_DATASOURCE_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false

grpc:
  server:
    port: ${GRPC_SERVER_PORT:9086}

jwt:
  secret: ${JWT_SECRET:YOUR_SECURE_256BIT_HEX_OR_BASE64_JWT_SECRET_KEY}

afromessage:
  api:
    key: ${AFROMESSAGE_API_KEY:mock-key}
    url: ${AFROMESSAGE_API_URL:https://api.afromessage.com/api/send}

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: always
