apiVersion: v1
kind: Secret
metadata:
  name: sacco-secrets
  namespace: sacco-core
type: Opaque
stringData:
  # 🔐 JWT Signing & Verification Key (256-bit Hex Key)
  # Replace with a cryptographically secure 256-bit hex secret for production
  JWT_SECRET: "YOUR_SECURE_256_BIT_JWT_SECRET_HERE"

  # 📲 AfroMessage SMS Gateway Credentials
  # Replace with your active AfroMessage API Key from https://afromessage.com
  AFROMESSAGE_API_KEY: "YOUR_AFROMESSAGE_API_KEY_HERE"
  AFROMESSAGE_API_URL: "https://api.afromessage.com/api/send"

  # 🗄️ PostgreSQL Master Credentials
  POSTGRES_DB: "qershi-link"
  POSTGRES_USERNAME: "postgres"
  POSTGRES_PASSWORD: "postgres"
