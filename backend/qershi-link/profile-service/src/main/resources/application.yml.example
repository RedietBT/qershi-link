# Member Profile Service Configuration Template
# Copy this file to application.yml and replace placeholder values for local development.

server:
  port: ${SERVER_PORT:8081}

spring:
  application:
    name: profile-service
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/qershi-link?stringtype=unspecified}
    username: ${SPRING_DATASOURCE_USERNAME:postgres}
    password: ${SPRING_DATASOURCE_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        default_schema: ${SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA:profile_schema}

grpc:
  server:
    port: ${GRPC_SERVER_PORT:9081}

jwt:
  secret: ${JWT_SECRET:YOUR_SECURE_256BIT_HEX_OR_BASE64_JWT_SECRET_KEY}

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: always
